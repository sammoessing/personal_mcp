# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Workspace whose data the static MCP_ACCESS_TOKEN may reach, by slug.
# Browser clients use OAuth and pick their workspace at consent time instead.
MCP_STATIC_TOKEN_WORKSPACE=personal

# 32+ char random secret used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Bearer token MCP clients (Claude Desktop, Claude Code, etc.) must send as
# `Authorization: Bearer <value>`. Generate with: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# --- Invite emails (optional) ---
# Option A: send from your own Gmail. Requires 2-Step Verification, then an
# app password from Google Account → Security → App passwords. Invites arrive
# genuinely from this address, and there is no domain to verify.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Charted

# Option B: send from a domain you own, via Resend. Only used when the Gmail
# values above are unset.
RESEND_API_KEY=
EMAIL_FROM=

# --- Connector OAuth apps ---
# Each connector needs its own OAuth app registered with the provider.
# A connector's "Connect" button is disabled on /connections until both
# of its env vars below are set — you can add these incrementally.

# GitHub OAuth App → github.com/settings/developers
# Authorization callback URL: <your-domain>/api/connectors/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Linear OAuth application → linear.app/settings/api/applications
# Callback URL: <your-domain>/api/connectors/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Google Cloud OAuth client (shared by Calendar + Gmail) → console.cloud.google.com
# Enable the Calendar API and Gmail API on the project.
# Authorized redirect URIs:
#   <your-domain>/api/connectors/google_calendar/callback
#   <your-domain>/api/connectors/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion integration (public OAuth) → notion.so/my-integrations
# Redirect URI: <your-domain>/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack app → api.slack.com/apps
# Redirect URL: <your-domain>/api/connectors/slack/callback
# Bot token scopes: channels:read, chat:write, users:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Discord application → discord.com/developers/applications
# Redirect: <your-domain>/api/connectors/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
